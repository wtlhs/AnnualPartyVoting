{
  "name": "annual-party-voting",
  "version": "1.0.0",
  "description": "年会最佳服装评选H5应用 - Annual Party Best Outfit Voting H5 Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:cluster": "node server-cluster.js",
    "start:lan": "node server-lan.js",
    "start:https": "node server-https.js",
    "start:prod": "node start-production.js",
    "generate-ssl": "node generate-ssl-fixed.js",
    "dev": "nodemon server.js",
    "dev:cluster": "nodemon server-cluster.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "npm run type-check",
    "deploy": "npm install && npm run start:prod",
    "deploy:lan": "npm install && npm run start:lan",
    "deploy:https": "npm run generate-ssl && npm run start:https"
  },
  "keywords": [
    "voting",
    "h5",
    "annual-party",
    "qrcode",
    "mobile"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.3",
    "selfsigned": "^5.5.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jsdom": "^27.4.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
